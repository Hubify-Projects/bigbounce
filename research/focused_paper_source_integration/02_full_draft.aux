\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left: $\sigma (f_{\rm  NL})$ vs.\ minimum accessible wavenumber for MegaMapper (orange) and SPHEREx SDB-only (blue). The SPHEREx bispectrum channel ($\sigma = 0.7$, dotted) avoids the ultra-large-scale fragility. Right: corresponding detection significance for $f_{\rm  NL}= -35/8$.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:kmin}{{4}{13}{Left: $\sigma (\fnl )$ vs.\ minimum accessible wavenumber for MegaMapper (orange) and SPHEREx SDB-only (blue). The SPHEREx bispectrum channel ($\sigma = 0.7$, dotted) avoids the ultra-large-scale fragility. Right: corresponding detection significance for $\fnl = -35/8$}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B}PNG Bias ($b_\phi $) Sensitivity}{13}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: $\sigma (f_{\rm  NL})$ as a function of $b_\phi $ prior uncertainty for MegaMapper SDB (blue). The SPHEREx bispectrum constraint (red dashed) is less sensitive to $b_\phi $ than SDB but not independent of it; the residual dependence enters at tree level through the $\Delta b(k) \propto f_{\rm  NL}\, b_\phi / k^2$ cross-terms $f_{\rm  NL}\, b_\phi \, b_1^2 P(k_1) P(k_2)$ in the multi-tracer Fisher matrix~\cite  {Heinrich:2023}, which propagate to all triangle configurations and not only the squeezed limit. Right: corresponding detection significance for $f_{\rm  NL}= -35/8$. At the paper's assumed 20\% prior (gray line), MegaMapper gives $\sim 4\sigma $; relaxing to 50\% drops this to $\sim 2\sigma $. The bispectrum channel remains at $\sim 5\sigma $ (optimistic) or $\sim 3$--$4\sigma $ (after GR degradation) at fixed Heinrich \textit  {et~al.}~$b_\phi $ universality~\cite  {Heinrich:2023}; relaxing $b_\phi $ universality per tracer bin~\cite  {Barreira:2022} degrades the optimistic $5.2$--$5.5\sigma $ headline to ${\sim }\,4.0$--$4.2\sigma $ ($30\%$ central) and ${\sim }\,3.5$--$3.7\sigma $ ($50\%$ conservative).}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:bphi}{{5}{13}{Left: $\sigma (\fnl )$ as a function of $b_\phi $ prior uncertainty for MegaMapper SDB (blue). The SPHEREx bispectrum constraint (red dashed) is less sensitive to $b_\phi $ than SDB but not independent of it; the residual dependence enters at tree level through the $\Delta b(k) \propto \fnl \, b_\phi / k^2$ cross-terms $\fnl \, b_\phi \, b_1^2 P(k_1) P(k_2)$ in the multi-tracer Fisher matrix~\cite {Heinrich:2023}, which propagate to all triangle configurations and not only the squeezed limit. Right: corresponding detection significance for $\fnl = -35/8$. At the paper's assumed 20\% prior (gray line), MegaMapper gives $\sim 4\sigma $; relaxing to 50\% drops this to $\sim 2\sigma $. The bispectrum channel remains at $\sim 5\sigma $ (optimistic) or $\sim 3$--$4\sigma $ (after GR degradation) at fixed Heinrich \etal ~$b_\phi $ universality~\cite {Heinrich:2023}; relaxing $b_\phi $ universality per tracer bin~\cite {Barreira:2022} degrades the optimistic $5.2$--$5.5\sigma $ headline to ${\sim }\,4.0$--$4.2\sigma $ ($30\%$ central) and ${\sim }\,3.5$--$3.7\sigma $ ($50\%$ conservative)}{figure.5}{}}
