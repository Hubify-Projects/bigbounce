\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Dual-normalization SPHEREx detection forecast for the matter-bounce $f_{\rm  NL}$ prediction. Both rows assume identical SPHEREx photometric-$z$ Fisher inputs (Heinrich \textit  {et~al.}~\cite  {Heinrich:2023}) with $\sigma (f_{\rm  NL})=0.7$ in the bispectrum channel and the noise-weighted template overlap $r=0.84$ from Sec.~\ref {sec:template}; the only difference is which convention's predicted $|f_{\rm  NL}|$ is used to compute the significance $|f_{\rm  NL}|\,r/\sigma (f_{\rm  NL})$.}}{13}{table.4}\protected@file@percent }
