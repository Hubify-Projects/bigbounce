\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Detection significance for $f_{\rm  NL}= -35/8$ across survey configurations, plotted at the template-corrected values used in the text. SPHEREx bars (left to right): the naive uncorrected $|f_{\rm  NL}|/\sigma (f_{\rm  NL}) = 4.375/0.70 = 6.25\sigma $ (hatched gray; shown only for reference, \emph  {not used in any headline}); the template-corrected optimistic bispectrum forecast $5.2$--$5.5\sigma $ ($|f_{\rm  NL}|\,r/\sigma $ with noise-weighted $r=0.84$, \S  \ref {sec:spherex}); the realistic post-systematic-budget envelope $2.6$--$5\sigma $ (\S  \ref {sec:systematics}); and the all-combined conservative endpoint $2.6$--$2.8\sigma $ (effective $\sigma _{\rm  eff}$ ranges from $\sqrt  {0.9^2+1.0^2} = 1.35$ at the central $b_\phi $-widened scenario to $\sqrt  {1.0^2+1.0^2} = 1.41$ at the conservative endpoint; \S  \ref {sec:spherex}). MegaMapper bars: template-corrected ideal $7.4$--$7.7\sigma $ (\S  \ref {sec:megamapper}); the illustrative $3$--$7\sigma $ design-uncertainty envelope; conservative; and single-tracer. Error bars span the optimistic endpoint (published ideal $\sigma (f_{\rm  NL})$ with template-overlap correction only) to the conservative endpoint (full \S  \ref {sec:systematics} budget: $r=0.84$ overlap, $\epsilon $-correction, photometric-$z$ degradation, PNG bias, $b_\phi $ marginalization, and GR-projection marginalization ($\sigma _{\rm  GR}$, Table~\ref {tab:gr})).}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:surveys}{{2}{11}{Detection significance for $\fnl = -35/8$ across survey configurations, plotted at the template-corrected values used in the text. SPHEREx bars (left to right): the naive uncorrected $|\fnl |/\sigma (\fnl ) = 4.375/0.70 = 6.25\sigma $ (hatched gray; shown only for reference, \emph {not used in any headline}); the template-corrected optimistic bispectrum forecast $5.2$--$5.5\sigma $ ($|\fnl |\,r/\sigma $ with noise-weighted $r=0.84$, \S \ref {sec:spherex}); the realistic post-systematic-budget envelope $2.6$--$5\sigma $ (\S \ref {sec:systematics}); and the all-combined conservative endpoint $2.6$--$2.8\sigma $ (effective $\sigma _{\rm eff}$ ranges from $\sqrt {0.9^2+1.0^2} = 1.35$ at the central $b_\phi $-widened scenario to $\sqrt {1.0^2+1.0^2} = 1.41$ at the conservative endpoint; \S \ref {sec:spherex}). MegaMapper bars: template-corrected ideal $7.4$--$7.7\sigma $ (\S \ref {sec:megamapper}); the illustrative $3$--$7\sigma $ design-uncertainty envelope; conservative; and single-tracer. Error bars span the optimistic endpoint (published ideal $\sigma (\fnl )$ with template-overlap correction only) to the conservative endpoint (full \S \ref {sec:systematics} budget: $r=0.84$ overlap, $\epsilon $-correction, photometric-$z$ degradation, PNG bias, $b_\phi $ marginalization, and GR-projection marginalization ($\sigma _{\rm GR}$, Table~\ref {tab:gr}))}{figure.2}{}}
