\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left: $\sigma (f_{\rm  NL})$ vs.\ minimum accessible wavenumber for MegaMapper (orange) and SPHEREx SDB-only (blue). The SPHEREx bispectrum channel ($\sigma = 0.7$, dotted) avoids the ultra-large-scale fragility. Right: corresponding detection significance for $f_{\rm  NL}= -35/8$.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:kmin}{{4}{8}{Left: $\sigma (\fnl )$ vs.\ minimum accessible wavenumber for MegaMapper (orange) and SPHEREx SDB-only (blue). The SPHEREx bispectrum channel ($\sigma = 0.7$, dotted) avoids the ultra-large-scale fragility. Right: corresponding detection significance for $\fnl = -35/8$}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B}PNG Bias ($b_\phi $) Sensitivity}{8}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {C}Parameterized GR-Degradation Analysis}{8}{section*.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: $\sigma (f_{\rm  NL})$ as a function of $b_\phi $ prior uncertainty for MegaMapper SDB (blue). The SPHEREx bispectrum constraint (red dashed) is nearly independent of $b_\phi $. Right: corresponding detection significance for $f_{\rm  NL}= -35/8$. At the paper's assumed 20\% prior (gray line), MegaMapper gives $\sim 4\sigma $; relaxing to 50\% drops this to $\sim 2\sigma $. The bispectrum channel remains at $\sim 5\sigma $ (optimistic) or $\sim 3$--$4\sigma $ (after GR degradation) regardless of $b_\phi $.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:bphi}{{5}{8}{Left: $\sigma (\fnl )$ as a function of $b_\phi $ prior uncertainty for MegaMapper SDB (blue). The SPHEREx bispectrum constraint (red dashed) is nearly independent of $b_\phi $. Right: corresponding detection significance for $\fnl = -35/8$. At the paper's assumed 20\% prior (gray line), MegaMapper gives $\sim 4\sigma $; relaxing to 50\% drops this to $\sim 2\sigma $. The bispectrum channel remains at $\sim 5\sigma $ (optimistic) or $\sim 3$--$4\sigma $ (after GR degradation) regardless of $b_\phi $}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Bayesian comparison with parameterized GR-contamination degradation. SSFSR = standard single-field slow-roll inflation. The bounce-vs-inflation comparison survives all treatment scenarios. $^a$The ``Corrected (10\% residual)'' row matches the ``Ideal'' row because, by construction, a 10\% residual GR contamination after correction has negligible impact on the Bayes factor at the reported significant-figure level ($\Delta \text  {BF} < 0.1$); the two rows are not independent scenarios but rather bookend the same GR-free regime.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:gr}{{III}{8}{Bayesian comparison with parameterized GR-contamination degradation. SSFSR = standard single-field slow-roll inflation. The bounce-vs-inflation comparison survives all treatment scenarios. $^a$The ``Corrected (10\% residual)'' row matches the ``Ideal'' row because, by construction, a 10\% residual GR contamination after correction has negligible impact on the Bayes factor at the reported significant-figure level ($\Delta \text {BF} < 0.1$); the two rows are not independent scenarios but rather bookend the same GR-free regime}{table.3}{}}
