{
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/papers/(.*\\.pdf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/old", "destination": "/old/index.html" },
    { "source": "/papers/:slug", "destination": "/papers/:slug.html" },
    { "source": "/papers/:slug/", "destination": "/papers/:slug.html" },
    { "source": "/activity", "destination": "/activity.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/architecture", "destination": "/architecture.html" }
  ],
  "redirects": [
    { "source": "/paper", "destination": "/research", "permanent": true },
    { "source": "/contributions", "destination": "/research#contributions", "permanent": true },
    { "source": "/final-review", "destination": "/status#signoff", "permanent": true },
    { "source": "/architecture", "destination": "/docs/architecture", "permanent": true },
    { "source": "/figures", "destination": "/explore/figures", "permanent": true },
    { "source": "/surveys", "destination": "/reproduce/surveys", "permanent": true },
    { "source": "/surveys/:slug", "destination": "/reproduce/surveys/:slug", "permanent": true },
    { "source": "/chat", "destination": "/", "permanent": true }
  ]
}
