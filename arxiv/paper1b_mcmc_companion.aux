\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces  $\Lambda $CDM$+\Delta N_{\rm  eff}$ proxy MCMC results from frozen Cobaya~v3.6.1 chains (CAMB~v1.6.5, stock; \emph  {no torsion modifications}). All values are posterior means $\pm \,1\sigma $. Reported as a null-consistency cross-check, \emph  {not} as evidence for the spin-torsion theory. $S_8 \equiv \sigma _8\,(\Omega _m/0.3)^{1/2}$, computed as a Cobaya derived parameter with exactly this definition. The full-tension column includes the DES-Y3 $S_8$ Gaussian prior $0.776 \pm 0.017$ (\texttt  {cobaya\_full\_tension.yaml}). [Correction note: an earlier version quoted the Planck+BAO+SN $S_8$ marginal as $0.831\pm 0.018$; the $\pm 0.018$ width could not be traced to any committed analysis, and a direct GetDist pass over the frozen chains gives $0.827\pm 0.010$ (132{,}949 samples), which replaces it in the table.] With the chain-recomputed marginal, the full-tension posterior $S_8 = 0.814\pm 0.008$ is consistent with the naive two-Gaussian combination of the Planck+BAO+SN marginal and the DES-Y3 prior ($0.827\pm 0.010 \otimes 0.776\pm 0.017 = 0.814\pm 0.009$; agreement at the $0.01\sigma $ level). The Planck+BAO+SN marginal sits in $2.6\sigma $ two-Gaussian tension with DES-Y3 (posterior-overlap integral $\DOTSI \intop \ilimits@ \!\min (p_1,p_2)\,dS_8 = 0.05$); the full-tension posterior sits at $2.0\sigma $ from DES-Y3 (overlap $0.12$); overlay artifact \texttt  {reproducibility/cosmology/} \texttt  {c13\_s8\_desy3\_overlay.json}.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:verification}{{I}{4}{$\Lambda $CDM$+\Delta \Neff $ proxy MCMC results from frozen Cobaya~v3.6.1 chains (CAMB~v1.6.5, stock; \emph {no torsion modifications}). All values are posterior means $\pm \,1\sigma $. Reported as a null-consistency cross-check, \emph {not} as evidence for the spin-torsion theory. $S_8 \equiv \sigma _8\,(\Omega _m/0.3)^{1/2}$, computed as a Cobaya derived parameter with exactly this definition. The full-tension column includes the DES-Y3 $S_8$ Gaussian prior $0.776 \pm 0.017$ (\texttt {cobaya\_full\_tension.yaml}). [Correction note: an earlier version quoted the Planck+BAO+SN $S_8$ marginal as $0.831\pm 0.018$; the $\pm 0.018$ width could not be traced to any committed analysis, and a direct GetDist pass over the frozen chains gives $0.827\pm 0.010$ (132{,}949 samples), which replaces it in the table.] With the chain-recomputed marginal, the full-tension posterior $S_8 = 0.814\pm 0.008$ is consistent with the naive two-Gaussian combination of the Planck+BAO+SN marginal and the DES-Y3 prior ($0.827\pm 0.010 \otimes 0.776\pm 0.017 = 0.814\pm 0.009$; agreement at the $0.01\sigma $ level). The Planck+BAO+SN marginal sits in $2.6\sigma $ two-Gaussian tension with DES-Y3 (posterior-overlap integral $\int \!\min (p_1,p_2)\,dS_8 = 0.05$); the full-tension posterior sits at $2.0\sigma $ from DES-Y3 (overlap $0.12$); overlay artifact \texttt {reproducibility/cosmology/} \texttt {c13\_s8\_desy3\_overlay.json}}{table.1}{}}
\newlabel{fn:rhat_csv}{{a}{4}{}{table.1-mpfootnote.a}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces  DESI~DR2 $w_0 w_a$ posterior summary ($N=128{,}385$ accepted samples across 16 chains, $\hat  R-1=0.00820$; 8 cosmological + 9 nuisance parameters). Likelihood stack: DESI~DR2~BAO + Planck NPIPE (PR4) CamSpec high-$\ell $ TTTEEE + Planck~2018 low-$\ell $ TT/EE + Planck~2018 lensing (\texttt  {native}) + DES-Y5 + Pantheon+. Full parameter list and chain diagnostics are available in the companion data repository. Derived-parameter widths are GetDist readouts of the full chain covariance: the chain's $\sigma _8$--$\Omega _m$ correlation is $\rho =-0.27$ (the standard CMB acoustic-scale/lensing degeneracy), which is why $\sigma _{S_8}=0.0089$ is smaller than the uncorrelated propagation through $S_8=\sigma _8(\Omega _m/0.3)^{0.5}$ ($\approx 0.010$).}}{5}{table.2}\protected@file@percent }
\newlabel{tab:iter2_posterior}{{II}{5}{DESI~DR2 $w_0 w_a$ posterior summary ($N=128{,}385$ accepted samples across 16 chains, $\hat R-1=0.00820$; 8 cosmological + 9 nuisance parameters). Likelihood stack: DESI~DR2~BAO + Planck NPIPE (PR4) CamSpec high-$\ell $ TTTEEE + Planck~2018 low-$\ell $ TT/EE + Planck~2018 lensing (\texttt {native}) + DES-Y5 + Pantheon+. Full parameter list and chain diagnostics are available in the companion data repository. Derived-parameter widths are GetDist readouts of the full chain covariance: the chain's $\sigma _8$--$\Omega _m$ correlation is $\rho =-0.27$ (the standard CMB acoustic-scale/lensing degeneracy), which is why $\sigma _{S_8}=0.0089$ is smaller than the uncorrelated propagation through $S_8=\sigma _8(\Omega _m/0.3)^{0.5}$ ($\approx 0.010$)}{table.2}{}}
