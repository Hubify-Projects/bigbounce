\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces  Cross-paper status table (Wave 14 / Mid-May 2026). Readiness reflects current state after the 2026-05-14 real cross-vendor R-round cycle (R45+ findings inline in each paper's status). Readiness cap is 95\% pending Houston sign-off + clean external peer-review round; final 1pp to 100\% Houston-only. DESI DR2 cobaya chains: see Table~\ref {tab:mcmc_inventory} for current slow-mode-dominated state.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:crosspaper}{{II}{6}{Cross-paper status table (Wave 14 / Mid-May 2026). Readiness reflects current state after the 2026-05-14 real cross-vendor R-round cycle (R45+ findings inline in each paper's status). Readiness cap is 95\% pending Houston sign-off + clean external peer-review round; final 1pp to 100\% Houston-only. DESI DR2 cobaya chains: see Table~\ref {tab:mcmc_inventory} for current slow-mode-dominated state}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces  MCMC program inventory. The cobaya DESI DR2 $w_0 w_a$ iter2 chain (16-chain MPI, OMP=6 isolation) is, as of 2026-05-14 22:53~UTC, at $59{,}832$ accepted samples with $\hat  {R}-1 = 0.01945$ (last flushed 22:53~UTC; \emph  {slow-mode-dominated, not stalled} --- the chain has progressed from the v1B.0.6 snapshot of $53{,}736$/$0.01775$ at 15:43~UTC by ${\sim }6{,}000$ samples). The slight $\hat  {R}-1$ uptick from $0.01775$ to $0.01945$ is expected behavior for a slow-mixing chain exploring newly opened posterior volume and is not a divergence. The 2 frozen chains below ($\Lambda $CDM+$\Delta N_{\rm  eff}$ proxy, $w_0 w_a$ not sampled) suffice for the P1(b) headline conclusions of this companion paper; the DESI DR2 $w_0 w_a$ chain is forward work to be incorporated into Paper~I(a)'s \S  ~Structural Tension as a future quintom-B empirical test once it reaches the standard publication target $\hat  {R}-1 < 10^{-2}$.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:mcmc_inventory}{{III}{6}{MCMC program inventory. The cobaya DESI DR2 $w_0 w_a$ iter2 chain (16-chain MPI, OMP=6 isolation) is, as of 2026-05-14 22:53~UTC, at $59{,}832$ accepted samples with $\hat {R}-1 = 0.01945$ (last flushed 22:53~UTC; \emph {slow-mode-dominated, not stalled} --- the chain has progressed from the v1B.0.6 snapshot of $53{,}736$/$0.01775$ at 15:43~UTC by ${\sim }6{,}000$ samples). The slight $\hat {R}-1$ uptick from $0.01775$ to $0.01945$ is expected behavior for a slow-mixing chain exploring newly opened posterior volume and is not a divergence. The 2 frozen chains below ($\Lambda $CDM+$\Delta \Neff $ proxy, $w_0 w_a$ not sampled) suffice for the P1(b) headline conclusions of this companion paper; the DESI DR2 $w_0 w_a$ chain is forward work to be incorporated into Paper~I(a)'s \S ~Structural Tension as a future quintom-B empirical test once it reaches the standard publication target $\hat {R}-1 < 10^{-2}$}{table.3}{}}
