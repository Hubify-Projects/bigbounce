\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Full-tension MCMC corner plot (119{,}617 post-burnin samples, \texttt  {getdist}-thinned from 176{,}240 raw; footnote~\ref {fn:sample_stratification}) over Planck+BAO+SN+H0+$S_8$. The $\Delta N_{\rm  eff}$ posterior is consistent with zero ($-0.020\pm 0.169$), confirming no additional relativistic species at recombination.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:corner_full_tension}{{1}{6}{Full-tension MCMC corner plot (119{,}617 post-burnin samples, \texttt {getdist}-thinned from 176{,}240 raw; footnote~\ref {fn:sample_stratification}) over Planck+BAO+SN+H0+$S_8$. The $\Delta \Neff $ posterior is consistent with zero ($-0.020\pm 0.169$), confirming no additional relativistic species at recombination}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $\Delta N_{\rm  eff}$ marginal posterior comparison across the two frozen dataset combinations of Table~\ref {tab:verification} ($176{,}240$ and $132{,}949$ samples). Panel (a): Gaussian summaries of the $\Delta N_{\rm  eff}$ marginal posteriors at the Table~\ref {tab:verification} means $\pm \,1\sigma $, with the Standard-Model value $\Delta N_{\rm  eff}=0$ marked. Panel (b): all seven Table~\ref {tab:verification} parameters, normalized to the full-tension mean and $\sigma $. Both combinations recover $\Delta N_{\rm  eff}$ consistent with zero at $<\!1\sigma $; the headline ``full-tension'' stack (Planck+BAO+SN+H$_0$+$S_8$) gives $\Delta N_{\rm  eff}= -0.020\pm 0.169$. The standard-ECH route to dark energy via additional relativistic species at recombination is therefore not viable as an amplitude-level explanation of either tension. }}{6}{figure.2}\protected@file@percent }
\newlabel{fig:dneff_viability}{{2}{6}{$\Delta \Neff $ marginal posterior comparison across the two frozen dataset combinations of Table~\ref {tab:verification} ($176{,}240$ and $132{,}949$ samples). Panel (a): Gaussian summaries of the $\Delta \Neff $ marginal posteriors at the Table~\ref {tab:verification} means $\pm \,1\sigma $, with the Standard-Model value $\Delta \Neff =0$ marked. Panel (b): all seven Table~\ref {tab:verification} parameters, normalized to the full-tension mean and $\sigma $. Both combinations recover $\Delta \Neff $ consistent with zero at $<\!1\sigma $; the headline ``full-tension'' stack (Planck+BAO+SN+H$_0$+$S_8$) gives $\Delta \Neff = -0.020\pm 0.169$. The standard-ECH route to dark energy via additional relativistic species at recombination is therefore not viable as an amplitude-level explanation of either tension}{figure.2}{}}
