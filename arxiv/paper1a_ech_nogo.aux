\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Observational decision timeline for the two surviving ECH-independent class-level falsification paths.} Top: LiteBIRD CMB birefringence ($\sigma (\beta )\!\approx \!0.03^\circ $, launch early 2030s) testing the spectator-ALP route 4. Bottom: SPHEREx galaxy bispectrum ($\sim \!2028$ first cosmological data release) testing the matter-bounce $f_{\rm  NL}=-35/8$ prediction at $2.6$--$5\sigma $ realistic significance (footnote~\ref {fn:spherex_range}). Both surveys deliver ECH-independent class-level discrimination tests; under the stated ans\"atze they can falsify the relevant matter-bounce and uniform spectator-ALP benchmarks, but they do not identify a unique surviving minimal-ECH channel. Curve families labeled $\rho =0,\,0.3,\,0.5$ correspond to the assumed cross-correlation coefficient $\rho $ between the $f_{\rm  NL}$ and $\beta $ joint-forecast estimators (with $\rho =0$ the uncorrelated baseline; $\rho >0$ combinations track the gain in joint significance under a positive between-estimator correlation).}}{15}{figure.4}\protected@file@percent }
\newlabel{fig:obs_timeline}{{4}{15}{\textbf {Observational decision timeline for the two surviving ECH-independent class-level falsification paths.} Top: LiteBIRD CMB birefringence ($\sigma (\beta )\!\approx \!0.03^\circ $, launch early 2030s) testing the spectator-ALP route 4. Bottom: SPHEREx galaxy bispectrum ($\sim \!2028$ first cosmological data release) testing the matter-bounce $\fnl =-35/8$ prediction at $2.6$--$5\sigma $ realistic significance (footnote~\ref {fn:spherex_range}). Both surveys deliver ECH-independent class-level discrimination tests; under the stated ans\"atze they can falsify the relevant matter-bounce and uniform spectator-ALP benchmarks, but they do not identify a unique surviving minimal-ECH channel. Curve families labeled $\rho =0,\,0.3,\,0.5$ correspond to the assumed cross-correlation coefficient $\rho $ between the $\fnl $ and $\beta $ joint-forecast estimators (with $\rho =0$ the uncorrelated baseline; $\rho >0$ combinations track the gain in joint significance under a positive between-estimator correlation)}{figure.4}{}}
