\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cosmic rotation $\omega $ vs Hubble expansion $H$.} Distance-impact of a residual cosmic rotation component on the late-time Hubble flow. The CMB isotropy bound $(\omega /H)_0 < 5\times 10^{-11}$ from Saadeh~\textit  {et~al.}~\cite  {Saadeh2016} pins the rotation contribution to $\Lambda _{\rm  eff} = c_\omega \omega ^2$ (Eq.~\ref {eq:Leff_full}) at the $\lesssim \!10^{-22}\,\rho _\Lambda ^{\rm  obs}$ level --- negligible at all redshifts. (The panel's burned-in annotation quotes the equivalent bound as a fractional contribution to the expansion rate, $|\omega ^2/H^2| < 10^{-20}$; the two statements bound the same rotation term in different units.) The dark-energy mechanism in this paper is therefore the $\Xi \,M_{\rm  Pl}^2$ term sourced by the parity-odd contorsion sector (\S  \ref {sec:parityodd}), \emph  {not} the rotation component.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:rotation_expansion}{{3}{6}{\textbf {Cosmic rotation $\omega $ vs Hubble expansion $H$.} Distance-impact of a residual cosmic rotation component on the late-time Hubble flow. The CMB isotropy bound $(\omega /H)_0 < 5\times 10^{-11}$ from Saadeh~\etal ~\cite {Saadeh2016} pins the rotation contribution to $\Lambda _{\rm eff} = c_\omega \omega ^2$ (Eq.~\ref {eq:Leff_full}) at the $\lesssim \!10^{-22}\,\rho _\Lambda ^{\rm obs}$ level --- negligible at all redshifts. (The panel's burned-in annotation quotes the equivalent bound as a fractional contribution to the expansion rate, $|\omega ^2/H^2| < 10^{-20}$; the two statements bound the same rotation term in different units.) The dark-energy mechanism in this paper is therefore the $\Xi \,\MPl ^2$ term sourced by the parity-odd contorsion sector (\S \ref {sec:parityodd}), \emph {not} the rotation component}{figure.3}{}}
\newlabel{eq:rhocrit}{{9}{6}{}{equation.9}{}}
