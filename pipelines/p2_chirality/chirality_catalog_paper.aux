\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Angular power spectrum of the chirality asymmetry map (Catalog~C, equivariant) for multipoles $\ell = 1$--$5$. Black points show the measured $C_\ell $ values; the gray band indicates the $1\sigma $ and $2\sigma $ envelopes from 1{,}000 Monte Carlo null realizations. Note: the figure as plotted shows the original raw pseudo-$C_\ell $ ($\ell =1$ at $2.75\sigma $ relative to the original shot-noise floor). After the corrected $N_{\rm  spiral}$ normalization the pseudo-$C_\ell $ SNR is $6.48\sigma $ and the MASTER-decoupled value is $6.08\sigma $; however, these are intermediate estimators before full mode-coupling inversion. The canonical primary result (Sec.~\ref {sec:dipole}) is the post-MASTER deconvolution significance of $-0.12\sigma $, fully consistent with null. The $6.48\sigma $/$6.08\sigma $ values reflect mask-induced mode coupling explicitly removed by MASTER deconvolution and should not be quoted as a detection. Verification artifact: \texttt  {pipelines/h200\_results/wave11c\_nspiral\_recompute\_2026-05-01/results.json}. All higher multipoles are consistent with noise. The absence of coherent power at any scale beyond the lowest bin rules out a large-scale parity-violation \emph  {dipole} above the ${\sim }0.2\%$ level (minimum detectable at $3\sigma $); the spatially uniform monopole offset (across all 7 equatorial coordinate slabs) is $0.26\%$ (see Sec.~\ref {sec:cw_frac}). }}{16}{figure.8}\protected@file@percent }
\newlabel{fig:multipoles}{{8}{16}{Angular power spectrum of the chirality asymmetry map (Catalog~C, equivariant) for multipoles $\ell = 1$--$5$. Black points show the measured $C_\ell $ values; the gray band indicates the $1\sigmaunit $ and $2\sigmaunit $ envelopes from 1{,}000 Monte Carlo null realizations. Note: the figure as plotted shows the original raw pseudo-$C_\ell $ ($\ell =1$ at $2.75\sigmaunit $ relative to the original shot-noise floor). After the corrected $N_{\rm spiral}$ normalization the pseudo-$C_\ell $ SNR is $6.48\sigma $ and the MASTER-decoupled value is $6.08\sigma $; however, these are intermediate estimators before full mode-coupling inversion. The canonical primary result (Sec.~\ref {sec:dipole}) is the post-MASTER deconvolution significance of $-0.12\sigmaunit $, fully consistent with null. The $6.48\sigma $/$6.08\sigma $ values reflect mask-induced mode coupling explicitly removed by MASTER deconvolution and should not be quoted as a detection. Verification artifact: \texttt {pipelines/h200\_results/wave11c\_nspiral\_recompute\_2026-05-01/results.json}. All higher multipoles are consistent with noise. The absence of coherent power at any scale beyond the lowest bin rules out a large-scale parity-violation \emph {dipole} above the ${\sim }0.2\%$ level (minimum detectable at $3\sigmaunit $); the spatially uniform monopole offset (across all 7 equatorial coordinate slabs) is $0.26\%$ (see Sec.~\ref {sec:cw_frac})}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Hemisphere asymmetry scan results. Each point represents the CW fraction difference between a pair of opposing hemispheres, evaluated for great-circle axes in $10^\circ $ increments of Galactic longitude and latitude ($\sim \!650$ directions). The dashed horizontal lines mark $2\sigma $ and $3\sigma $ thresholds. The peak asymmetry of $3.05\sigma $ (red diamond) has an amplitude of only $0.17\%$ and does not survive look-elsewhere correction (effective significance $<1\sigma $). }}{16}{figure.9}\protected@file@percent }
\newlabel{fig:hemisphere}{{9}{16}{Hemisphere asymmetry scan results. Each point represents the CW fraction difference between a pair of opposing hemispheres, evaluated for great-circle axes in $10^\circ $ increments of Galactic longitude and latitude ($\sim \!650$ directions). The dashed horizontal lines mark $2\sigmaunit $ and $3\sigmaunit $ thresholds. The peak asymmetry of $3.05\sigmaunit $ (red diamond) has an amplitude of only $0.17\%$ and does not survive look-elsewhere correction (effective significance $<1\sigmaunit $)}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces CW fraction by sky region for Catalog~C (equivariant). Each bar shows the CW/(CW$+$CCW) fraction in one of seven sky regions defined by RA quadrant and declination band. The dashed line marks exact parity (0.5000). All regions fall within $\pm 0.5\%$ of 50/50, confirming the absence of position-dependent classification bias. Error bars show $1\sigma $ binomial uncertainties. Note that the spiral fraction varies substantially across regions (Sec.~\ref {sec:spiral_fraction_variation}), but the chirality balance does not. }}{16}{figure.10}\protected@file@percent }
\newlabel{fig:sky_regions}{{10}{16}{CW fraction by sky region for Catalog~C (equivariant). Each bar shows the CW/(CW$+$CCW) fraction in one of seven sky regions defined by RA quadrant and declination band. The dashed line marks exact parity (0.5000). All regions fall within $\pm 0.5\%$ of 50/50, confirming the absence of position-dependent classification bias. Error bars show $1\sigmaunit $ binomial uncertainties. Note that the spiral fraction varies substantially across regions (Sec.~\ref {sec:spiral_fraction_variation}), but the chirality balance does not}{figure.10}{}}
