\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces HEALPix sky map ($\texttt  {NSIDE}= 64$, Mollweide projection) of the per-pixel chirality asymmetry $A_p = (N_{\rm  CW} - N_{\rm  CCW}) / (N_{\rm  CW} + N_{\rm  CCW})$ for Catalog~C (equivariant). The color scale spans $\pm 5\%$. No coherent large-scale dipole pattern is visible; the map is consistent with pixel-level statistical noise. Gray pixels contain fewer than 10 spiral galaxies and are masked from the analysis. Compare with the raw Catalog~A map (Fig.~\ref {fig:raw_vs_eq}), which shows a dramatic spurious dipole aligned with the survey footprint. }}{14}{figure.7}\protected@file@percent }
\newlabel{fig:sky_map}{{7}{14}{HEALPix sky map ($\nside = 64$, Mollweide projection) of the per-pixel chirality asymmetry $A_p = (N_{\rm CW} - N_{\rm CCW}) / (N_{\rm CW} + N_{\rm CCW})$ for Catalog~C (equivariant). The color scale spans $\pm 5\%$. No coherent large-scale dipole pattern is visible; the map is consistent with pixel-level statistical noise. Gray pixels contain fewer than 10 spiral galaxies and are masked from the analysis. Compare with the raw Catalog~A map (Fig.~\ref {fig:raw_vs_eq}), which shows a dramatic spurious dipole aligned with the survey footprint}{figure.7}{}}
