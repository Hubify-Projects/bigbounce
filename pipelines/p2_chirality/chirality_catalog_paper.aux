\citation{Gross:2010}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Angular power spectrum of the chirality asymmetry map (Catalog~C, equivariant) for multipoles $\ell = 1$--$5$. Black points show the measured $C_\ell $ values; the gray band indicates the $1\sigma $ and $2\sigma $ envelopes from 1{,}000 Monte Carlo null realizations. Only $\ell = 1$ approaches the $2\sigma $ boundary (at $2.75\sigma $); all higher multipoles are fully consistent with noise. The absence of coherent power at any scale rules out a large-scale parity-violation \emph  {dipole} above the ${\sim }0.2\%$ level (minimum detectable at $3\sigma $); the spatially uniform monopole offset is $0.26\%$ (see Sec.~\ref {sec:cw_frac}). }}{10}{figure.8}\protected@file@percent }
\newlabel{fig:multipoles}{{8}{10}{Angular power spectrum of the chirality asymmetry map (Catalog~C, equivariant) for multipoles $\ell = 1$--$5$. Black points show the measured $C_\ell $ values; the gray band indicates the $1\sigmaunit $ and $2\sigmaunit $ envelopes from 1{,}000 Monte Carlo null realizations. Only $\ell = 1$ approaches the $2\sigmaunit $ boundary (at $2.75\sigmaunit $); all higher multipoles are fully consistent with noise. The absence of coherent power at any scale rules out a large-scale parity-violation \emph {dipole} above the ${\sim }0.2\%$ level (minimum detectable at $3\sigmaunit $); the spatially uniform monopole offset is $0.26\%$ (see Sec.~\ref {sec:cw_frac})}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {D}Hemisphere Asymmetry}{10}{section*.22}\protected@file@percent }
\newlabel{sec:hemisphere}{{IV\,D}{10}{}{section*.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Hemisphere asymmetry scan results. Each point represents the CW fraction difference between a pair of opposing hemispheres, evaluated for great-circle axes in $10^\circ $ increments of Galactic longitude and latitude ($\sim \!650$ directions). The dashed horizontal lines mark $2\sigma $ and $3\sigma $ thresholds. The peak asymmetry of $3.05\sigma $ (red diamond) has an amplitude of only $0.17\%$ and does not survive look-elsewhere correction (effective significance $<1\sigma $). }}{11}{figure.9}\protected@file@percent }
\newlabel{fig:hemisphere}{{9}{11}{Hemisphere asymmetry scan results. Each point represents the CW fraction difference between a pair of opposing hemispheres, evaluated for great-circle axes in $10^\circ $ increments of Galactic longitude and latitude ($\sim \!650$ directions). The dashed horizontal lines mark $2\sigmaunit $ and $3\sigmaunit $ thresholds. The peak asymmetry of $3.05\sigmaunit $ (red diamond) has an amplitude of only $0.17\%$ and does not survive look-elsewhere correction (effective significance $<1\sigmaunit $)}{figure.9}{}}
