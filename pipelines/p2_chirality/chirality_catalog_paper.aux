\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Injection-recovery probabilities $P(\sigma \!>\!3)$ vs.\ injected full amplitude $A$ (HC-broad subsample, $p_{\rm  eq}\!>\!0.6$, $N\!=\!949{,}584$; $N_{\rm  MC,inj}\!=\!100$ per amplitude, per-pixel-shuffle null). Each injection draws a new random dipole axis, so the quoted $P$ values are \emph  {axis-averaged} detection probabilities, not fixed-axis completeness (axis protocol and orientation spread: Sec.~\ref {sec:sensitivity} text). The $\geq \!95\%$ crossing is bracketed between $A\!=\!1.0\%$ and $A\!=\!1.5\%$, not measured. With $N_{\rm  MC,inj}\!=\!100$ per amplitude, each tabulated $P$ carries a binomial standard error $\sqrt  {P(1-P)/100}\!\leq \!0.05$ (e.g.\ $0.55\pm 0.05$ at $A\!=\!0.75\%$), so $A_{50}\!\approx \!0.75\%$ is quoted at the tested-grid precision, not as a two-decimal measurement.}}{13}{table.5}\protected@file@percent }
\newlabel{tab:injection_recovery}{{V}{13}{Injection-recovery probabilities $P(\sigma \!>\!3)$ vs.\ injected full amplitude $A$ (HC-broad subsample, $p_{\rm eq}\!>\!0.6$, $N\!=\!949{,}584$; $N_{\rm MC,inj}\!=\!100$ per amplitude, per-pixel-shuffle null). Each injection draws a new random dipole axis, so the quoted $P$ values are \emph {axis-averaged} detection probabilities, not fixed-axis completeness (axis protocol and orientation spread: Sec.~\ref {sec:sensitivity} text). The $\geq \!95\%$ crossing is bracketed between $A\!=\!1.0\%$ and $A\!=\!1.5\%$, not measured. With $N_{\rm MC,inj}\!=\!100$ per amplitude, each tabulated $P$ carries a binomial standard error $\sqrt {P(1-P)/100}\!\leq \!0.05$ (e.g.\ $0.55\pm 0.05$ at $A\!=\!0.75\%$), so $A_{50}\!\approx \!0.75\%$ is quoted at the tested-grid precision, not as a two-decimal measurement}{table.5}{}}
