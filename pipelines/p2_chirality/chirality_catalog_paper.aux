\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Hemisphere asymmetry scan results. Each point represents the CW fraction difference between a pair of opposing hemispheres, evaluated for great-circle axes in $10^\circ $ increments of Galactic longitude and latitude ($\sim \!650$ directions). The dashed horizontal lines mark $2\sigma $ and $3\sigma $ thresholds. The peak asymmetry of $3.05\sigma $ (red diamond, local pre-LEE significance) has a CW-fraction half-difference amplitude of only $0.17\%$ (full dipole-amplitude $\max |A| = 0.853\%$ under $p_{\rm  CW} = \tfrac  12(1+A\cos \theta )$). The conservative analytic Bonferroni / BH penalty across ${\sim }650$ directions reduces the local effective significance to $<\!1\sigma $ (consistent with null). The direct $10{,}000$-MC permutation null gives $p_{\rm  LEE}\!\le \!10^{-4}$ (zero of $10{,}000$ random-label shuffles reach the data), which \emph  {rejects} the random-label null at post-LEE $\gtrsim \!3.7\sigma $ — but per-pixel-shuffle nulls do not preserve depth or mask-edge systematic structures, so this rejection is consistent with (and most plausibly attributed to) the same sub-percent GZ1-training-label / depth-coupled systematic that sources the global $9.5\sigma $ CW-fraction monopole, not to a primordial $\ell \!=\!1$ dipole (the independent full-sky dipole estimators on the same data are all null at $\ell \!=\!1$; Sec.~\ref {sec:dipole}, Sec.~\ref {sec:conclusions}). }}{18}{figure.9}\protected@file@percent }
\newlabel{fig:hemisphere}{{9}{18}{Hemisphere asymmetry scan results. Each point represents the CW fraction difference between a pair of opposing hemispheres, evaluated for great-circle axes in $10^\circ $ increments of Galactic longitude and latitude ($\sim \!650$ directions). The dashed horizontal lines mark $2\sigmaunit $ and $3\sigmaunit $ thresholds. The peak asymmetry of $3.05\sigmaunit $ (red diamond, local pre-LEE significance) has a CW-fraction half-difference amplitude of only $0.17\%$ (full dipole-amplitude $\max |A| = 0.853\%$ under $p_{\rm CW} = \tfrac 12(1+A\cos \theta )$). The conservative analytic Bonferroni / BH penalty across ${\sim }650$ directions reduces the local effective significance to $<\!1\sigmaunit $ (consistent with null). The direct $10{,}000$-MC permutation null gives $p_{\rm LEE}\!\le \!10^{-4}$ (zero of $10{,}000$ random-label shuffles reach the data), which \emph {rejects} the random-label null at post-LEE $\gtrsim \!3.7\sigmaunit $ — but per-pixel-shuffle nulls do not preserve depth or mask-edge systematic structures, so this rejection is consistent with (and most plausibly attributed to) the same sub-percent GZ1-training-label / depth-coupled systematic that sources the global $9.5\sigmaunit $ CW-fraction monopole, not to a primordial $\ell \!=\!1$ dipole (the independent full-sky dipole estimators on the same data are all null at $\ell \!=\!1$; Sec.~\ref {sec:dipole}, Sec.~\ref {sec:conclusions})}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces CW fraction by sky region for Catalog~C (equivariant). Each bar shows the CW/(CW$+$CCW) fraction in one of seven sky regions defined by RA quadrant and declination band. The dashed line marks exact parity (0.5000). All regions fall within $\pm 0.5\%$ of 50/50, confirming the absence of position-dependent classification bias. Error bars show $1\sigma $ binomial uncertainties. Note that the spiral fraction varies substantially across regions (Sec.~\ref {sec:spiral_fraction_variation}), but the chirality balance does not. }}{18}{figure.10}\protected@file@percent }
\newlabel{fig:sky_regions}{{10}{18}{CW fraction by sky region for Catalog~C (equivariant). Each bar shows the CW/(CW$+$CCW) fraction in one of seven sky regions defined by RA quadrant and declination band. The dashed line marks exact parity (0.5000). All regions fall within $\pm 0.5\%$ of 50/50, confirming the absence of position-dependent classification bias. Error bars show $1\sigmaunit $ binomial uncertainties. Note that the spiral fraction varies substantially across regions (Sec.~\ref {sec:spiral_fraction_variation}), but the chirality balance does not}{figure.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces CW fraction by sky region (Catalog~C). All regions are within 0.5\% of exact parity. $^{\mathrm  {a}}$The per-region $N_{\rm  spiral}$ counts and the all-sky total ($3{,}321{,}795$) shown here come from the original snapshot of the equivariant classification used to compute the regional CW-fraction breakdown; the paper-canonical equivariant spiral total used for the dipole and NaMaster shot-noise normalization (Sec.~\ref {sec:dipole}) is $N_{\rm  spiral}^{\rm  eq} = 3{,}201{,}160$ from the on-disk \texttt  {class\_eq} column of \artifact  {catalog\_production.parquet} (cross-model peer-review verdict, supersedes for noise-floor purposes). Both totals appear as separate rows in the table for verification continuity; the per-region $|\Delta |$ values shift by $\lesssim 4\%$ relative under the canonical denominator (Sec.~\ref {sec:cw_frac}), and the headline factor of $\sim \!6$--$12$ (central $\sim \!9$) Shamir-comparator range remains unchanged. $^{\mathrm  {b}}$The bolded ``All sky (canonical)'' row carries the canonical $N_{\rm  spiral}=3{,}201{,}160$ denominator but inherits the $\textsc  {cw}/(\textsc  {cw}+\textsc  {ccw})=0.4974$ and $|\Delta |=0.26\%$ from the snapshot row because the per-region maxima are insensitive at the displayed three-significant-figure precision to the $\lesssim 4\%$ relative shift between $3{,}321{,}795$ and $3{,}201{,}160$ (the per-galaxy CW labels are unchanged across the recount; only the spiral-vs-non-spiral $\textsc  {not\_spiral}{}$/edge-on classification was updated, and the affected boundary objects redistribute uniformly across the seven regions). An explicit per-region recompute at the canonical denominator is deferred to the verification artifact \artifact  {pipelines/h200\_results/wave14\_canonical\_recount/sky\_balance\_canonical.json}; the snapshot row is retained alongside the canonical row so the reader can verify the $\lesssim 4\%$ insensitivity claim directly. }}{18}{table.5}\protected@file@percent }
\newlabel{tab:sky_balance}{{V}{18}{CW fraction by sky region (Catalog~C). All regions are within 0.5\% of exact parity. $^{\mathrm {a}}$The per-region $N_{\rm spiral}$ counts and the all-sky total ($3{,}321{,}795$) shown here come from the original snapshot of the equivariant classification used to compute the regional CW-fraction breakdown; the paper-canonical equivariant spiral total used for the dipole and NaMaster shot-noise normalization (Sec.~\ref {sec:dipole}) is $N_{\rm spiral}^{\rm eq} = 3{,}201{,}160$ from the on-disk \texttt {class\_eq} column of \artifact {catalog\_production.parquet} (cross-model peer-review verdict, supersedes for noise-floor purposes). Both totals appear as separate rows in the table for verification continuity; the per-region $|\Delta |$ values shift by $\lesssim 4\%$ relative under the canonical denominator (Sec.~\ref {sec:cw_frac}), and the headline factor of $\sim \!6$--$12$ (central $\sim \!9$) Shamir-comparator range remains unchanged. $^{\mathrm {b}}$The bolded ``All sky (canonical)'' row carries the canonical $N_{\rm spiral}=3{,}201{,}160$ denominator but inherits the $\CW /(\CW +\CCW )=0.4974$ and $|\Delta |=0.26\%$ from the snapshot row because the per-region maxima are insensitive at the displayed three-significant-figure precision to the $\lesssim 4\%$ relative shift between $3{,}321{,}795$ and $3{,}201{,}160$ (the per-galaxy CW labels are unchanged across the recount; only the spiral-vs-non-spiral $\NS {}$/edge-on classification was updated, and the affected boundary objects redistribute uniformly across the seven regions). An explicit per-region recompute at the canonical denominator is deferred to the verification artifact \artifact {pipelines/h200\_results/wave14\_canonical\_recount/sky\_balance\_canonical.json}; the snapshot row is retained alongside the canonical row so the reader can verify the $\lesssim 4\%$ insensitivity claim directly}{table.5}{}}
