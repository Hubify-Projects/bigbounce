\citation{Motloch:2021}
\citation{Yu:2020}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Per-bin equivariant CW fraction for the three continuous morphology axes available in the production catalog (\emph  {left:} log Sersic effective radius $\log _{10} r_{\rm  eff}$, a half-light-radius proxy; \emph  {center:} de-Vaucouleurs profile fraction \texttt  {fracdev}; \emph  {right:} axis ratio $b/a$). Error bars are per-bin Poisson standard errors. The horizontal red line is the catalog-wide CW fraction $0.4974\%$; the dashed black line is the parity-symmetric $50/50$. Per-axis maximum bin-to-bin spread (printed in each subplot title) is below $0.32\%$ for size and $b/a$ and reaches $1.41\%$ for fracdev, driven by the high-fracdev tail (smallest-$N$ bin at $fracdev{>}0.5$, $n\!=\!10{,}941$, where the per-bin Poisson SE is $\sqrt  {0.5{\cdot }0.5/n}\!\approx \!0.48\%$); the $1.41\%$ spread is statistically significant at ${\sim }\,2.9\sigma $ on the bin's own scatter, consistent with the morphology-classification correlation discussed in Sec.~\ref {sec:bin_flatness} and \emph  {not} attributable to small-$N$ Poisson scatter alone. Across all axes the per-bin CW fraction sits within $\sim \!0.3\%$ of the catalog-wide baseline, consistent with the spatially uniform monopole picture; \emph  {none} of the axes shows a directional dipole signature, the parity-violation observable. Companion artifact: \texttt  {r42\_results/wave\_14\_oo\_bin\_flatness.json}. }}{24}{figure.12}\protected@file@percent }
\newlabel{fig:binned_cw_fraction}{{12}{24}{Per-bin equivariant CW fraction for the three continuous morphology axes available in the production catalog (\emph {left:} log Sersic effective radius $\log _{10} r_{\rm eff}$, a half-light-radius proxy; \emph {center:} de-Vaucouleurs profile fraction \texttt {fracdev}; \emph {right:} axis ratio $b/a$). Error bars are per-bin Poisson standard errors. The horizontal red line is the catalog-wide CW fraction $0.4974\%$; the dashed black line is the parity-symmetric $50/50$. Per-axis maximum bin-to-bin spread (printed in each subplot title) is below $0.32\%$ for size and $b/a$ and reaches $1.41\%$ for fracdev, driven by the high-fracdev tail (smallest-$N$ bin at $fracdev{>}0.5$, $n\!=\!10{,}941$, where the per-bin Poisson SE is $\sqrt {0.5{\cdot }0.5/n}\!\approx \!0.48\%$); the $1.41\%$ spread is statistically significant at ${\sim }\,2.9\sigma $ on the bin's own scatter, consistent with the morphology-classification correlation discussed in Sec.~\ref {sec:bin_flatness} and \emph {not} attributable to small-$N$ Poisson scatter alone. Across all axes the per-bin CW fraction sits within $\sim \!0.3\%$ of the catalog-wide baseline, consistent with the spatially uniform monopole picture; \emph {none} of the axes shows a directional dipole signature, the parity-violation observable. Companion artifact: \texttt {r42\_results/wave\_14\_oo\_bin\_flatness.json}}{figure.12}{}}
