\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Side-by-side comparison of the chirality asymmetry sky maps for Catalog~A (raw, \emph  {left}) and Catalog~C (equivariant, \emph  {right}), both at $\texttt  {NSIDE}= 64$ in Mollweide projection. The raw map exhibits a $2.31\sigma $ real-space dipole (with pre-MASTER pseudo-$C_\ell $ at $\ell \!=\!1$ inflated to $6.48\sigma $) aligned with the DESI Legacy survey footprint, produced by a classifier CW bias of only $0.79\%$ modulated by non-uniform sky coverage. Equivariant averaging (Eq.~\ref {eq:tta}) eliminates this systematic entirely, yielding a noise-consistent map at $0.43\sigma $. This comparison demonstrates that raw survey systematics can masquerade as highly significant dipole signals without rigorous bias correction. }}{19}{figure.11}\protected@file@percent }
\newlabel{fig:raw_vs_eq}{{11}{19}{Side-by-side comparison of the chirality asymmetry sky maps for Catalog~A (raw, \emph {left}) and Catalog~C (equivariant, \emph {right}), both at $\nside = 64$ in Mollweide projection. The raw map exhibits a $2.31\sigmaunit $ real-space dipole (with pre-MASTER pseudo-$C_\ell $ at $\ell \!=\!1$ inflated to $6.48\sigmaunit $) aligned with the DESI Legacy survey footprint, produced by a classifier CW bias of only $0.79\%$ modulated by non-uniform sky coverage. Equivariant averaging (Eq.~\ref {eq:tta}) eliminates this systematic entirely, yielding a noise-consistent map at $0.43\sigmaunit $. This comparison demonstrates that raw survey systematics can masquerade as highly significant dipole signals without rigorous bias correction}{figure.11}{}}
