\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Headline-estimator summary. $N_{\rm  catalog\,spiral}$ is the underlying Catalog~C spiral count (CW+CCW only). $N_{\rm  map\,weighted} = \DOTSB \sum@ \slimits@ _{p\in \rm  mask} W_p$ where $W_p = N_{\rm  all}^{(p)}$ is the total classified-galaxy count in pixel~$p$ (CW+CCW+NS), used as a survey-depth weight in the NaMaster field object. $N_{\rm  map\,weighted}$ exceeds $N_{\rm  catalog\,spiral}$ because $W_p$ includes non-spiral galaxies (${\sim }62\%$ of the catalog); each galaxy is counted once. Row~(iv) is the apodized-footprint MASTER diagnostic ($N_{\rm  all}\!\geq \!1$ mask, $C^2$ $2^\circ $ apodization); its two $\sigma $ values are against the global per-galaxy label-shuffle and depth-stratified nulls respectively (both systematics-attributed; Appendices~A, D). \emph  {The $\sigma $ values in different rows are computed against different null procedures (column ``Null'') and are not directly comparable across rows.} Row~(v) reports the post-look-elsewhere-corrected significance; the raw direct-MC value is $p_{\rm  LEE}\!\le \!10^{-4}$ against the random-label max-statistic null, which \emph  {already incorporates} the look-elsewhere scan; the additional Bonferroni/BH pass over the 648 tested directions reported in Appendix~C is a second, deliberately conservative penalty (the two corrections bracket the significance), and the rejection is systematics-attributed either way. Row~(vii) uses the HC-broad subsample ($p_{\rm  eq}\!>\!0.6$; Sec.~\ref {sec:sensitivity}). A ``---'' in $N_{\rm  map\,weighted}$ marks rows where the NaMaster weight construction is not invoked.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:headline_summary}{{I}{5}{Headline-estimator summary. $N_{\rm catalog\,spiral}$ is the underlying Catalog~C spiral count (CW+CCW only). $N_{\rm map\,weighted} = \sum _{p\in \rm mask} W_p$ where $W_p = N_{\rm all}^{(p)}$ is the total classified-galaxy count in pixel~$p$ (CW+CCW+NS), used as a survey-depth weight in the NaMaster field object. $N_{\rm map\,weighted}$ exceeds $N_{\rm catalog\,spiral}$ because $W_p$ includes non-spiral galaxies (${\sim }62\%$ of the catalog); each galaxy is counted once. Row~(iv) is the apodized-footprint MASTER diagnostic ($N_{\rm all}\!\geq \!1$ mask, $C^2$ $2^\circ $ apodization); its two $\sigma $ values are against the global per-galaxy label-shuffle and depth-stratified nulls respectively (both systematics-attributed; Appendices~A, D). \emph {The $\sigma $ values in different rows are computed against different null procedures (column ``Null'') and are not directly comparable across rows.} Row~(v) reports the post-look-elsewhere-corrected significance; the raw direct-MC value is $p_{\rm LEE}\!\le \!10^{-4}$ against the random-label max-statistic null, which \emph {already incorporates} the look-elsewhere scan; the additional Bonferroni/BH pass over the 648 tested directions reported in Appendix~C is a second, deliberately conservative penalty (the two corrections bracket the significance), and the rejection is systematics-attributed either way. Row~(vii) uses the HC-broad subsample ($p_{\rm eq}\!>\!0.6$; Sec.~\ref {sec:sensitivity}). A ``---'' in $N_{\rm map\,weighted}$ marks rows where the NaMaster weight construction is not invoked}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Global CW fraction across catalog tiers. Uncertainties are $1\sigma $ binomial, $\sigma =\sqrt  {f(1-f)/N_{\rm  spiral}}$, with per-tier spiral counts ($N_{\rm  spiral}^{\rm  A}\!=\!3{,}321{,}795$; $N_{\rm  spiral}^{\rm  C}\!=\!3{,}201{,}160$); parentheses give the $1\sigma $ uncertainty on the trailing digits ($0.507879(274)\equiv 0.507879\pm 0.000274$). The Excess column is the deviation $f_{\rm  CW}-0.5$ in percent ($f_{\rm  CW}$ units; multiply by 2 for asymmetry-$A$ units). Dev.\ is the \emph  {signed} $(f_{\rm  CW}-0.5)/\sigma $ computed from the unrounded fraction. The Catalog-B row derives from the Platt-calibrated fraction; its deviation is computed from the unrounded calibrated fraction. }}{5}{table.2}\protected@file@percent }
\newlabel{tab:cw_frac}{{II}{5}{Global CW fraction across catalog tiers. Uncertainties are $1\sigmaunit $ binomial, $\sigma =\sqrt {f(1-f)/N_{\rm spiral}}$, with per-tier spiral counts ($N_{\rm spiral}^{\rm A}\!=\!3{,}321{,}795$; $N_{\rm spiral}^{\rm C}\!=\!3{,}201{,}160$); parentheses give the $1\sigmaunit $ uncertainty on the trailing digits ($0.507879(274)\equiv 0.507879\pm 0.000274$). The Excess column is the deviation $f_{\rm CW}-0.5$ in percent ($f_{\rm CW}$ units; multiply by 2 for asymmetry-$A$ units). Dev.\ is the \emph {signed} $(f_{\rm CW}-0.5)/\sigma $ computed from the unrounded fraction. The Catalog-B row derives from the Platt-calibrated fraction; its deviation is computed from the unrounded calibrated fraction}{table.2}{}}
