\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Demonstration of the test-time equivariant averaging procedure (Eq.~\ref {eq:tta}). \emph  {Left column:} original galaxy images. \emph  {Center column:} horizontally reflected images. \emph  {Right column:} probability bar charts showing the raw softmax outputs for each orientation and the final equivariant probabilities. The CW and CCW channels swap exactly upon reflection; the equivariant average symmetrizes the two passes, eliminating the horizontal-flip component of orientation-dependent bias (rotational dependence at $90^\circ $/$180^\circ $/$270^\circ $ is not eliminated; see Sec.~\ref {sec:cw_frac}). The \textsc  {not\_spiral}{} probability is invariant under reflection by construction. }}{8}{figure.4}\protected@file@percent }
\newlabel{fig:equivariance_demo}{{4}{8}{Demonstration of the test-time equivariant averaging procedure (Eq.~\ref {eq:tta}). \emph {Left column:} original galaxy images. \emph {Center column:} horizontally reflected images. \emph {Right column:} probability bar charts showing the raw softmax outputs for each orientation and the final equivariant probabilities. The CW and CCW channels swap exactly upon reflection; the equivariant average symmetrizes the two passes, eliminating the horizontal-flip component of orientation-dependent bias (rotational dependence at $90^\circ $/$180^\circ $/$270^\circ $ is not eliminated; see Sec.~\ref {sec:cw_frac}). The \NS {} probability is invariant under reflection by construction}{figure.4}{}}
