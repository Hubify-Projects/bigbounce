\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces CW fraction by sky region for Catalog~C (equivariant). Each bar shows the CW/(CW$+$CCW) fraction in one of seven sky regions defined by RA quadrant and declination band. The dashed line marks exact parity (0.5000). All regions fall within $\pm 0.5\%$ of 50/50, confirming the absence of position-dependent classification bias. Error bars show $1\sigma $ binomial uncertainties. Note that the spiral fraction varies substantially across regions (Sec.~\ref {sec:spiral_fraction_variation}), but the chirality balance does not. }}{11}{figure.10}\protected@file@percent }
\newlabel{fig:sky_regions}{{10}{11}{CW fraction by sky region for Catalog~C (equivariant). Each bar shows the CW/(CW$+$CCW) fraction in one of seven sky regions defined by RA quadrant and declination band. The dashed line marks exact parity (0.5000). All regions fall within $\pm 0.5\%$ of 50/50, confirming the absence of position-dependent classification bias. Error bars show $1\sigmaunit $ binomial uncertainties. Note that the spiral fraction varies substantially across regions (Sec.~\ref {sec:spiral_fraction_variation}), but the chirality balance does not}{figure.10}{}}
