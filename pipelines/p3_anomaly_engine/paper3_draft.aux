\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces  Computational details of the multi-survey anomaly sweep. Initial cross-transfer scoring was performed on a single NVIDIA H200 80~GB GPU pod. Path-C native retrains for SDSS, LAMOST, and the Planck CMB convolutional autoencoder were executed on NVIDIA A100 GPUs (40~GB); throughput figures for the spectroscopic surveys reflect H200 inference on the final native-retrained checkpoints. Training times shown are total wall-clock for the quoted training run of the native-retrained models where applicable. Training configurations: spectroscopic \textsc  {BigAE}{} models train on $4.7\times 10^4$ (DESI) or $2$--$5\times 10^5$-spectrum pools at batch size 512 for up to 200 epochs with early stopping (\S  \ref {sec:training}), converging at 100--150 epochs; photometric models (eROSITA, Gaia, NEOWISE) are ${\lesssim }120$K-parameter networks on small catalog-feature tables, hence single-digit-second training times.}}{22}{table.5}\protected@file@percent }
\newlabel{tab:processing}{{V}{22}{Computational details of the multi-survey anomaly sweep. Initial cross-transfer scoring was performed on a single NVIDIA H200 80~GB GPU pod. Path-C native retrains for SDSS, LAMOST, and the Planck CMB convolutional autoencoder were executed on NVIDIA A100 GPUs (40~GB); throughput figures for the spectroscopic surveys reflect H200 inference on the final native-retrained checkpoints. Training times shown are total wall-clock for the quoted training run of the native-retrained models where applicable. Training configurations: spectroscopic \BigAE {} models train on $4.7\times 10^4$ (DESI) or $2$--$5\times 10^5$-spectrum pools at batch size 512 for up to 200 epochs with early stopping (\S \ref {sec:training}), converging at 100--150 epochs; photometric models (eROSITA, Gaia, NEOWISE) are ${\lesssim }120$K-parameter networks on small catalog-feature tables, hence single-digit-second training times}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces  DESI DR1 anomaly classification by spectral-arm dominance. Multi-band anomalies (77.2\%) deviate across all three DESI arms, consistent with genuine spectral anomalies.}}{22}{table.6}\protected@file@percent }
\newlabel{tab:desi_bands}{{VI}{22}{DESI DR1 anomaly classification by spectral-arm dominance. Multi-band anomalies (77.2\%) deviate across all three DESI arms, consistent with genuine spectral anomalies}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces  \textit  {Legacy fixed-$\alpha $ reference (superseded by empirical $\alpha _{\rm  jk}$ result of \S  \ref {sec:fnl}).} Sensitivity of $\sigma (f_{\rm  NL})$ to the bias enhancement factor $\alpha $, under the prior fixed-$\alpha $ assumption. Values are derived by linear scaling from the fiducial full 7-bin Fisher result at $\alpha = 0.15$ (boldface row; matches the Section~\ref {sec:fnl} baseline exactly). The standard DESI-only baseline is $\sigma (f_{\rm  NL})^{\rm  std} = 8.98$.}}{22}{table.7}\protected@file@percent }
