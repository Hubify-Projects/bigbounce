\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  Spatial distribution of the $195{,}829$ DESI~DR1 anomalies. \textit  {Top left:} equatorial sky map color-coded by anomaly score $S$. \textit  {Top right / bottom left:} RA and Dec marginal distributions, which follow the DESI Main Survey tile-coverage footprint. \textit  {Bottom right:} anomaly score versus angular distance from the Galactic plane, showing no score--latitude trend (cf.\ the combined-catalog Spearman $r = 0.0005$, $p = 0.92$ null result of \S  \ref {sec:spatial}). The footprint structure visible in the map reflects survey selection, not intrinsic anomaly clustering (see the $\chi ^2$ caveat in the text).}}{14}{figure.7}\protected@file@percent }
\newlabel{fig:anomaly_sky}{{7}{14}{Spatial distribution of the $195{,}829$ DESI~DR1 anomalies. \textit {Top left:} equatorial sky map color-coded by anomaly score $S$. \textit {Top right / bottom left:} RA and Dec marginal distributions, which follow the DESI Main Survey tile-coverage footprint. \textit {Bottom right:} anomaly score versus angular distance from the Galactic plane, showing no score--latitude trend (cf.\ the combined-catalog Spearman $r = 0.0005$, $p = 0.92$ null result of \S \ref {sec:spatial}). The footprint structure visible in the map reflects survey selection, not intrinsic anomaly clustering (see the $\chi ^2$ caveat in the text)}{figure.7}{}}
