\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-pixel signed $\sigma _{\rm  from\,half}$ for the chirality-relevant matched-spiral subsample at NSIDE=32 (Mollweide projection, equatorial coordinates). The observed $|\sigma |^{\rm  obs}_{\max }\!=\!4.13$ vs the label-shuffle null $|\sigma |^{\rm  null,\,p99}_{\max }\!=\!4.78$ gives a look-elsewhere $p\!=\!0.135$; no NSIDE returns $p\!<\!0.05$. The map shows no coherent large-scale structure beyond random pixel-level scatter; the high-$|\sigma |$ pixels are isolated rather than clustered, consistent with the counting-statistics distribution expected from label-shuffle.}}{14}{figure.6}\protected@file@percent }
\newlabel{fig:healpix_skymap}{{6}{14}{Per-pixel signed $\sigma _{\rm from\,half}$ for the chirality-relevant matched-spiral subsample at NSIDE=32 (Mollweide projection, equatorial coordinates). The observed $|\sigma |^{\rm obs}_{\max }\!=\!4.13$ vs the label-shuffle null $|\sigma |^{\rm null,\,p99}_{\max }\!=\!4.78$ gives a look-elsewhere $p\!=\!0.135$; no NSIDE returns $p\!<\!0.05$. The map shows no coherent large-scale structure beyond random pixel-level scatter; the high-$|\sigma |$ pixels are isolated rather than clustered, consistent with the counting-statistics distribution expected from label-shuffle}{figure.6}{}}
\citation{DESIVAST2025}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Phase 2 sensitivity sweep on the declared env-labeled parent: per-cell cross-class range of $f_{\rm  CW}$ (pp), void-class population (the bin whose counting noise dominates the range), maximum per-class monopole-subtracted residual $|\sigma _{\rm  obs}-\sigma _{\rm  pred}|$ [Eq.~\eqref  {eq:sigma_pred}], and label-shuffle look-elsewhere $p$-value on the max-class $|\sigma _{\rm  from\,half}|$ statistic ($N_{\rm  MC}=1{,}000$). The range column is dominated in every cell by the void-bin binomial error at these $n_{\rm  void}$. Per-cell void-bin deviations (top row to bottom): $|\sigma _{\rm  void}| = 0.47 / 1.07 / 0.93 / 0.68 / 1.08 / 0.86 / 0.95 / 1.35 / 0.87$, never exceeding $1.35$ (\href  {https://github.com/Hubify-Projects/bigbounce/blob/main/pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}{\nolinkurl  {pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}}). The $p_{\rm  LEE}$ values are corrected within each cell's own $K\!=\!4$ class family only; they are not globally corrected across the other scan families in this paper. A rerun with imaging-leg $\times $ program \emph  {stratified} shuffles leaves every cell's $p_{\rm  LEE}$ essentially unchanged (stratified $0.14$--$0.54$ vs.\ free $0.16$--$0.55$; $N_{\rm  MC}=1{,}000$), and a global max-stat correction across cells (one parent permutation propagated through all nine cells per draw, preserving cross-cell correlations) gives $p_{\rm  global} = 0.36$ over all nine cells and $0.27$ over the six resolved $R_s \in \{25,50\}$ cells (\href  {https://github.com/Hubify-Projects/bigbounce/blob/main/pipelines/p5\_desi\_chirality/outputs/24\_r24conf\_pod\_session.json}{\nolinkurl  {pipelines/p5\_desi\_chirality/outputs/24\_r24conf\_pod\_session.json}}). The $R_s\!=\!10$ rows sit below the $25.9\,{\rm  Mpc}/h$ grid sampling scale and are retained only as a degenerate near-unsmoothed limit, excluded from the robustness claim (\S  \ref {sec:phase2}).}}{15}{table.7}\protected@file@percent }
\newlabel{tab:phase2}{{VII}{15}{Phase 2 sensitivity sweep on the declared env-labeled parent: per-cell cross-class range of $f_{\rm CW}$ (pp), void-class population (the bin whose counting noise dominates the range), maximum per-class monopole-subtracted residual $|\sigma _{\rm obs}-\sigma _{\rm pred}|$ [Eq.~\eqref {eq:sigma_pred}], and label-shuffle look-elsewhere $p$-value on the max-class $|\sigma _{\rm from\,half}|$ statistic ($N_{\rm MC}=1{,}000$). The range column is dominated in every cell by the void-bin binomial error at these $n_{\rm void}$. Per-cell void-bin deviations (top row to bottom): $|\sigma _{\rm void}| = 0.47 / 1.07 / 0.93 / 0.68 / 1.08 / 0.86 / 0.95 / 1.35 / 0.87$, never exceeding $1.35$ (\artifact {pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}). The $p_{\rm LEE}$ values are corrected within each cell's own $K\!=\!4$ class family only; they are not globally corrected across the other scan families in this paper. A rerun with imaging-leg $\times $ program \emph {stratified} shuffles leaves every cell's $p_{\rm LEE}$ essentially unchanged (stratified $0.14$--$0.54$ vs.\^^Mfree $0.16$--$0.55$; $N_{\rm MC}=1{,}000$), and a global max-stat correction across cells (one parent permutation propagated through all nine cells per draw, preserving cross-cell correlations) gives $p_{\rm global} = 0.36$ over all nine cells and $0.27$ over the six resolved $R_s \in \{25,50\}$ cells (\artifact {pipelines/p5\_desi\_chirality/outputs/24\_r24conf\_pod\_session.json}). The $R_s\!=\!10$ rows sit below the $25.9\,{\rm Mpc}/h$ grid sampling scale and are retained only as a degenerate near-unsmoothed limit, excluded from the robustness claim (\S \ref {sec:phase2})}{table.7}{}}
