\@writefile{toc}{\contentsline {title}{Environmental Dependence of Spiral Chirality: A DESIVAST Three-Algorithm Test on 56{,}981 Void Spirals with T-Web (Hahn 2007) Tidal-Tensor Cross-Check Across the DR1 Matched-Spiral Sample\footnote {See \S  \ref {sec:env_finder} for the implementation note on the T-Web/V-Web nomenclature: the tidal-tensor classifier used here implements the Hahn 2007 T-Web recipe ($\phi _k = -\delta _k/k^2$ then $T_{ij} = -k_i k_j \phi _k$), not the Hoffman 2012 V-Web (velocity-shear). Earlier preprint versions used ``V-Web'' in the title for backward-compatibility with the HF dataset slug and the GitHub release tag; the title is updated to ``T-Web'' for accuracy.}}{1}{section*.2}\protected@file@percent }
