\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Density-quintile null with Paper IV monopole-prediction overlay. \emph  {Left:} CW fraction per projected-density quintile ($k\!=\!5$ NN proxy, $N\!=\!158{,}327$ per bin) with $95\%$ Jeffreys binomial CIs; dashed parity $f_{\rm  CW}\!=\!0.5$ and dotted Paper~IV $\bar  f_{\rm  CW}\!=\!0.4974$ references. \emph  {Right:} observed $\sigma _{\rm  from\,half}$ per quintile (bars) vs the Paper~IV-monopole prediction $\sigma _{\rm  pred}\!=\!-2\Delta f_{\rm  CW}\sqrt  {N}$ (red diamonds) at $\Delta f_{\rm  CW}\!=\!-0.0026$; dotted blue lines mark the Bonferroni-5 thresholds at $\alpha \!=\!0.01$. The observed signed $\sigma $ tracks the monopole prediction within counting statistics; no quintile deviates from the prediction by more than $\sim \!2\sigma $.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:cw_vs_density}{{3}{6}{Density-quintile null with Paper IV monopole-prediction overlay. \emph {Left:} CW fraction per projected-density quintile ($k\!=\!5$ NN proxy, $N\!=\!158{,}327$ per bin) with $95\%$ Jeffreys binomial CIs; dashed parity $f_{\rm CW}\!=\!0.5$ and dotted Paper~IV $\bar f_{\rm CW}\!=\!0.4974$ references. \emph {Right:} observed $\sigma _{\rm from\,half}$ per quintile (bars) vs the Paper~IV-monopole prediction $\sigma _{\rm pred}\!=\!-2\Delta f_{\rm CW}\sqrt {N}$ (red diamonds) at $\Delta f_{\rm CW}\!=\!-0.0026$; dotted blue lines mark the Bonferroni-5 thresholds at $\alpha \!=\!0.01$. The observed signed $\sigma $ tracks the monopole prediction within counting statistics; no quintile deviates from the prediction by more than $\sim \!2\sigma $}{figure.3}{}}
