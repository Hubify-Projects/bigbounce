\@writefile{lot}{\contentsline {table}{\numberline {XVI}{\ignorespaces $4{\times }2$ contingency table CW/CCW $\times $ V-Web class on the $812{,}793$-row env-labeled parent. Cells are exact integers $\mathrm  {CW} = n_{\rm  CW}$, $\mathrm  {CCW} = n - n_{\rm  CW}$ taken directly from the committed artifact arrays (\href  {https://github.com/Hubify-Projects/bigbounce/blob/main/pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}{\nolinkurl  {pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}}; \texttt  {parent\_env\_superset.per\_class}); $f_{\rm  CW}$ is the exact ratio rounded to four decimals for display. Sum: $n = 812{,}793$. Row marginals CW $= 404{,}111$, CCW $= 408{,}682$ (cells sum exactly to these marginals; see \href  {https://github.com/Hubify-Projects/bigbounce/blob/main/pipelines/p5\_desi\_chirality/outputs/31\_ext5\_appendixB\_tables.json}{\nolinkurl  {pipelines/p5\_desi\_chirality/outputs/31\_ext5\_appendixB\_tables.json}}). Pearson $\chi ^2 = 3.55$ ($3$ d.o.f., $p = 0.31$) on the row-level parent under the homogeneity null.}}{30}{table.16}\protected@file@percent }
\newlabel{tab:contingency_classCWCCW}{{XVI}{30}{$4{\times }2$ contingency table CW/CCW $\times $ V-Web class on the $812{,}793$-row env-labeled parent. Cells are exact integers $\mathrm {CW} = n_{\rm CW}$, $\mathrm {CCW} = n - n_{\rm CW}$ taken directly from the committed artifact arrays (\artifact {pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}; \texttt {parent\_env\_superset.per\_class}); $f_{\rm CW}$ is the exact ratio rounded to four decimals for display. Sum: $n = 812{,}793$. Row marginals CW $= 404{,}111$, CCW $= 408{,}682$ (cells sum exactly to these marginals; see \artifact {pipelines/p5\_desi\_chirality/outputs/31\_ext5\_appendixB\_tables.json}). Pearson $\chi ^2 = 3.55$ ($3$ d.o.f., $p = 0.31$) on the row-level parent under the homogeneity null}{table.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {XVII}{\ignorespaces $4{\times }2$ contingency table V-Web class $\times $ target program (\texttt  {bright}/\texttt  {dark}) on the $n_{\rm  bright+dark} = 811{,}609$ bright$+$dark subset of the env-labeled parent. Per-class $n$ values are the bright$+$dark subset totals (not the full $812{,}793$ env-labeled parent counts), and bright/dark cells are exact integers taken directly from the committed artifact arrays (\href  {https://github.com/Hubify-Projects/bigbounce/blob/main/pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}{\nolinkurl  {pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}}; \texttt  {T2\_contingency\_class\_x\_program.table}); $f_{\rm  bright}$ is the exact ratio rounded to four decimals for display. Pearson $\chi ^2 = 4932$ ($3$ d.o.f., $\log _{10} p \approx -1069$), Cram\'er's $V = \sqrt  {\chi ^2/n} = 0.078$.}}{30}{table.17}\protected@file@percent }
\newlabel{tab:contingency_classProgram}{{XVII}{30}{$4{\times }2$ contingency table V-Web class $\times $ target program (\texttt {bright}/\texttt {dark}) on the $n_{\rm bright+dark} = 811{,}609$ bright$+$dark subset of the env-labeled parent. Per-class $n$ values are the bright$+$dark subset totals (not the full $812{,}793$ env-labeled parent counts), and bright/dark cells are exact integers taken directly from the committed artifact arrays (\artifact {pipelines/p5\_desi\_chirality/outputs/17\_v0151\_closure\_recomputes.json}; \texttt {T2\_contingency\_class\_x\_program.table}); $f_{\rm bright}$ is the exact ratio rounded to four decimals for display. Pearson $\chi ^2 = 4932$ ($3$ d.o.f., $\log _{10} p \approx -1069$), Cram\'er's $V = \sqrt {\chi ^2/n} = 0.078$}{table.17}{}}
